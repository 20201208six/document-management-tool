{
  "name": "copywriting-assistant",
  "version": "1.0.0",
  "description": "文案助手 - 桌面端文案搜索与管理工具",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "pack": "powershell -ExecutionPolicy Bypass -File build.ps1",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tiptap/extension-bold": "^2.10.0",
    "@tiptap/extension-document": "^2.10.0",
    "@tiptap/extension-history": "^2.10.0",
    "@tiptap/extension-paragraph": "^2.10.0",
    "@tiptap/extension-text": "^2.10.0",
    "@tiptap/starter-kit": "^2.10.0",
    "@tiptap/vue-3": "^2.10.0",
    "@univerjs/core": "^0.25.1",
    "@univerjs/design": "^0.25.1",
    "@univerjs/preset-docs-core": "^0.25.1",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/preset-sheets-filter": "^0.25.1",
    "@univerjs/preset-sheets-find-replace": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "@univerjs/sheets": "^0.25.1",
    "@univerjs/sheets-filter-ui": "^0.25.1",
    "@univerjs/sheets-find-replace": "^0.25.1",
    "@univerjs/sheets-ui": "^0.25.1",
    "@univerjs/ui-adapter-vue3": "^0.25.1",
    "docx": "^8.5.0",
    "echarts": "^6.1.0",
    "electron-store": "^8.1.0",
    "element-plus": "^2.8.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.8.0",
    "markdown-it": "^14.2.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vue-tsc": "^2.1.0"
